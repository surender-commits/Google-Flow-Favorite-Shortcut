{
    "manifest_version": 3,
    "name": "Google Flow Favorite Shortcut",
    "version": "1.0.0",
    "description": "Press \\ to click the visible Favorite button in Google Flow.",
    "icons": {
        "16": "icon.png",
        "32": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://flow.google.com/*"
            ],
            "js": [
                "content.js"
            ]
            
        }
    ]
}